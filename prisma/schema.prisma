generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catering"]
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF

  @@schema("catering")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED

  @@schema("catering")
}

enum OrderStatus {
  DRAFT
  RSVP_OPEN
  RSVP_CLOSED
  CONFIRMED
  DELIVERED

  @@schema("catering")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("catering")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("catering")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("catering")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(STAFF)
  officeId      String?
  office        Office?   @relation(fields: [officeId], references: [id])
  accounts      Account[]
  sessions      Session[]
  rsvps         RSVP[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("catering")
}

model Office {
  id                  String        @id @default(cuid())
  name                String
  address             String?
  timezone            String        @default("America/New_York")
  budgetLimit         Float?
  dietaryRestrictions Json?
  cateringMaterials   String?       @db.Text
  stripeCustomerId    String?
  users               User[]
  subscription        Subscription?
  orders              Order[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@schema("catering")
}

model Subscription {
  id                   String             @id @default(cuid())
  officeId             String             @unique
  office               Office             @relation(fields: [officeId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  billingCycle         String             @default("weekly")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@schema("catering")
}

model CuisineType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  menus       Menu[]
  createdAt   DateTime @default(now())

  @@schema("catering")
}

model CulturalCelebration {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  cuisineType String?
  menus       Menu[]
  createdAt   DateTime @default(now())

  @@schema("catering")
}

model Menu {
  id                    String               @id @default(cuid())
  weekOf                DateTime
  cuisineTypeId         String
  cuisineType           CuisineType          @relation(fields: [cuisineTypeId], references: [id])
  culturalCelebrationId String?
  culturalCelebration   CulturalCelebration? @relation(fields: [culturalCelebrationId], references: [id])
  publishedAt           DateTime?
  items                 MenuItem[]
  orders                Order[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([weekOf, cuisineTypeId])
  @@schema("catering")
}

model MenuItem {
  id          String   @id @default(cuid())
  menuId      String
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  price       Float
  dietaryTags String[]
  imageUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("catering")
}

model Order {
  id           String      @id @default(cuid())
  officeId     String
  office       Office      @relation(fields: [officeId], references: [id])
  menuId       String
  menu         Menu        @relation(fields: [menuId], references: [id])
  status       OrderStatus @default(DRAFT)
  totalCost    Float?
  rsvpDeadline DateTime?
  rsvpToken    String?     @unique
  items        OrderItem[]
  rsvps        RSVP[]
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@schema("catering")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  price      Float
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  @@schema("catering")
}

model RSVP {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  selectedItems Json
  dietaryNotes  String?  @db.Text
  submittedAt   DateTime @default(now())

  @@unique([orderId, userId])
  @@schema("catering")
}
